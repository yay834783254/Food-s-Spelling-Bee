rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation Blueprint: UserProfile (/users/{userId})
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'userId',
          'displayName',
          'titleBadge',
          'bestWpm',
          'bestWord',
          'totalWordsSpelled',
          'totalScore',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'displayName',
          'titleBadge',
          'bestWpm',
          'bestWord',
          'totalWordsSpelled',
          'totalScore',
          'createdAt',
          'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40 &&
        data.titleBadge is string && data.titleBadge.size() >= 1 && data.titleBadge.size() <= 40 &&
        data.bestWpm is number && data.bestWpm >= 0 && data.bestWpm <= 450 &&
        data.bestWord is string && data.bestWord.size() >= 1 && data.bestWord.size() <= 45 &&
        data.totalWordsSpelled is number && data.totalWordsSpelled >= 0 && data.totalWordsSpelled <= 1000000 &&
        data.totalScore is number && data.totalScore >= 0 && data.totalScore <= 100000000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: LeaderboardEntry (/leaderboard_entries/{entryId})
    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
          'userId',
          'displayName',
          'titleBadge',
          'wpm',
          'peakWpm',
          'fastestWord',
          'difficulty',
          'score',
          'wordsSpelled',
          'accuracy',
          'playedAtMs',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'displayName',
          'titleBadge',
          'wpm',
          'peakWpm',
          'fastestWord',
          'difficulty',
          'score',
          'wordsSpelled',
          'accuracy',
          'playedAtMs',
          'createdAt'
        ]) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40 &&
        data.titleBadge is string && data.titleBadge.size() >= 1 && data.titleBadge.size() <= 40 &&
        data.wpm is number && data.wpm >= 0 && data.wpm <= 450 &&
        data.peakWpm is number && data.peakWpm >= 0 && data.peakWpm <= 450 &&
        data.fastestWord is string && data.fastestWord.size() >= 2 && data.fastestWord.size() <= 45 &&
        data.difficulty is string && data.difficulty.size() >= 4 && data.difficulty.size() <= 15 &&
        (data.difficulty in ['easy', 'medium', 'hard', 'verylong', 'progressive']) &&
        data.score is number && data.score >= 0 && data.score <= 10000000 &&
        data.wordsSpelled is number && data.wordsSpelled >= 1 && data.wordsSpelled <= 500 &&
        data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100 &&
        data.playedAtMs is number && data.playedAtMs >= 1700000000000 && data.playedAtMs <= 2500000000000 &&
        data.createdAt is timestamp && data.createdAt == request.time;
    }

    // Validation Blueprint: WordRecord (/word_records/{wordId})
    function isValidWordRecord(data) {
      return data.keys().hasAll([
          'word',
          'difficulty',
          'wpm',
          'userId',
          'displayName',
          'charCount',
          'durationMs',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'word',
          'difficulty',
          'wpm',
          'userId',
          'displayName',
          'charCount',
          'durationMs',
          'updatedAt'
        ]) &&
        data.word is string && data.word.size() >= 2 && data.word.size() <= 45 &&
        data.difficulty is string && data.difficulty.size() >= 4 && data.difficulty.size() <= 15 &&
        (data.difficulty in ['easy', 'medium', 'hard', 'verylong']) &&
        data.wpm is number && data.wpm > 0 && data.wpm <= 450 &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40 &&
        data.charCount is number && data.charCount >= 2 && data.charCount <= 45 &&
        data.durationMs is number && data.durationMs >= 100 && data.durationMs <= 600000 &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    // Connection test endpoint
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // User Profiles: Owner-only read/write, strict schema & immutability
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'titleBadge',
          'bestWpm',
          'bestWord',
          'totalWordsSpelled',
          'totalScore',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    // Global Leaderboard Entries: Immutable once created
    match /leaderboard_entries/{entryId} {
      allow get: if isValidId(entryId) && existing().wpm >= 0;
      allow list: if existing().wpm >= 0;

      allow create: if isVerifiedUser() &&
        isValidId(entryId) &&
        isValidLeaderboardEntry(incoming());

      allow update, delete: if false;
    }

    // Word Speed Records: Only updatable when breaking the existing WPM record for that exact word
    match /word_records/{wordId} {
      allow get: if isValidId(wordId) && existing().wpm >= 0;
      allow list: if existing().wpm >= 0;

      allow create: if isVerifiedUser() &&
        isValidId(wordId) &&
        isValidWordRecord(incoming());

      allow update: if isVerifiedUser() &&
        isValidId(wordId) &&
        isValidWordRecord(incoming()) &&
        incoming().word == existing().word &&
        incoming().difficulty == existing().difficulty &&
        incoming().charCount == existing().charCount &&
        incoming().wpm > existing().wpm &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'wpm',
          'userId',
          'displayName',
          'durationMs',
          'updatedAt'
        ]);

      allow delete: if false;
    }
  }
}
